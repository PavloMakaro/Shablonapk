<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top Action Bar (Custom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="@color/bg_main"
        android:elevation="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bot_avatar"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Jarvis"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginLeft="16dp" />

        <ImageView
            android:id="@+id/iv_menu_files"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Chat Message List -->
    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Loading Indicator / Streaming Text Indicator below the list -->
    <LinearLayout
        android:id="@+id/ll_streaming_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_streaming_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agent is thinking..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic"/>
    </LinearLayout>

    <!-- Bottom Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="bottom"
        android:background="@color/bg_main">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_attach"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_secondary"
            android:scaleType="centerInside" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxHeight="120dp"
            android:background="@drawable/bg_input"
            android:hint="@string/chat_input_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:padding="12dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary"
            android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>
